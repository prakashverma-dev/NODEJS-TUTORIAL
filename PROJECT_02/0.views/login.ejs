<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        body{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>

</head>
<body>
    
    <h1>Login</h1>
    <form action="/user/login" method="post">

        <label for="email">UserName</label>
        <input type="email" required name="email" id="email" placeholder="Enter your email" />

        <br>
        <label for="password">Password</label>
        <input type="password" required name="password" id="password" placeholder="Enter your password" />

        <br><br>

        <button type="submit">Login</button>

    </form>
    <br>

    <div>
        <% if (locals.signupSuccessMsg) { %>

            <strong><%= signupSuccessMsg %></strong>
         
        <% } %>
    </div>
    
    <div>
        <% if (locals.loginErr) { %>

            <strong><%= loginErr %></strong>
         
        <% } %>
    </div>

    <div>
        <h4>New User? <a href="/signup">Create New Account!</a>  </h4>
    </div>


</body>
</html>